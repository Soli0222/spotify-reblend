# APP Settings
PORT=3000
METRICS_PORT=9464
APP_ORIGIN=http://127.0.0.1:3000
ALLOWED_ORIGINS=http://127.0.0.1:3000
# Exclude top tracks shorter than this duration when generating blends. Set to 0 to disable.
MIN_TRACK_DURATION_MS=90000

# Security
# Use long random values in production.
# Generate AUTH_SECRET: openssl rand -base64 48
# Generate TOKEN_ENCRYPTION_KEY: openssl rand -hex 32
AUTH_SECRET=change_me_to_a_long_random_value
TOKEN_ENCRYPTION_KEY=change_me_to_a_32_byte_random_value

# Spotify API Credentials
# Get these from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# OpenTelemetry tracing
# Disabled by default. To enable tracing, set this to false and configure an OTLP endpoint.
OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=spotify-reblend-backend
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
